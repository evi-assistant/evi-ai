htmlcov/

# Virtual envs
.venv*/
venv/
env/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Local agent / tooling scratch dirs
.rstk/
# Repo-local git worktrees (<repo>/.worktrees/<branch>), made by `evi worktree
# create` (evi/worktree.py) and scripts/dev-bootstrap --worktree. In any other
# repo both keep them out of `git add` through .git/info/exclude instead.
.worktrees/
# Claude Code local config (settings.local.json, session locks, local rules)
.claude/

# Tauri / Node
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Tauri build-generated permission schemas (regenerated by tauri-build)
desktop/src-tauri/permissions/autogenerated/
# PyInstaller sidecars staged by build-sidecar
desktop/src-tauri/binaries/

# WebDriver binaries for the native-desktop test suite (tests/desktop_e2e).
# Machine-specific (msedgedriver must match the local WebView2 runtime); each
# dev/CI fetches its own — never commit the binary.
.webdrivers/

# Local-only secrets
.env
.env.local

# Repo-local eVi state stays out of git (user-level state lives in ~/.evi/),
# except what the loop shares through the repository: the task queue
# (evi/tasks.py), the bug-fix ledger (evi/bugledger.py) and the review
# guidance (evi/review.py). `.evi/*`, not `.evi/`: git can't re-include a
# file inside an ignored folder. Both rules are anchored to this folder, so
# `*/**/.evi/` keeps every .evi/ below it ignored (a session started in a
# subfolder leaves one there; the shared files live at the root only).
.evi/*
!.evi/tasks/
!.evi/bug-ledger.jsonl
!.evi/REVIEW.md
!.evi/review-rules.md
*/**/.evi/
